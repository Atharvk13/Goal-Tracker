GT_LLM_PROVIDER=ollama
GT_LLM_MODEL=qwen3:4b-instruct
GT_OLLAMA_BASE_URL=http://127.0.0.1:11434
GT_LLM_TEMPERATURE=0
GT_LLM_TIMEOUT_SECONDS=120
GT_LLM_CONTEXT_LENGTH=8192
GT_LLM_STRUCTURED_METHOD=json_schema
GT_TIMEZONE=Asia/Kolkata
# Optional: your own daily mail template (Subject line + body with {{placeholders}})
# GT_DAILY_MAIL_TEMPLATE=C:/path/to/daily_mail.txt

# Daily mail recipients (separate several with ;) and how to send:
# open  = open a filled message in your default mail app (new Outlook); you press Send
# send  = send directly through classic Outlook after you confirm
# draft = open the filled message in classic Outlook for you to send
# GT_MAIL_TO=manager@company.com
# GT_MAIL_CC=
GT_MAIL_SEND_MODE=open
